generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum StorefrontTemplate {
  MODERN
  CLASSIC
  MINIMAL
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CustomerStatus {
  ACTIVE
  DISABLED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  AWAITING_VERIFICATION
  PAID
  FAILED
  REFUNDED
}

enum DeliveryMethod {
  DELIVERY
  PICKUP
}

enum StoreUserRole {
  OWNER
  ADMIN
  STAFF
}

model Store {
  id           Int                @id @default(autoincrement())
  name         String             @db.VarChar(150)
  slug         String             @unique @db.VarChar(120)
  description  String?            @db.Text
  logoUrl      String?            @db.VarChar(500)
  primaryColor String?            @db.VarChar(20)
  template     StorefrontTemplate @default(MODERN)
  currency     String             @default("LKR") @db.VarChar(3)
  isActive     Boolean            @default(true)

  products      Product[]
  categories    Category[]
  customers     Customer[]
  orders        Order[]
  deliveryZones DeliveryZone[]
  users         StoreUser[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Category {
  id          Int     @id @default(autoincrement())
  storeId     Int
  name        String  @db.VarChar(120)
  slug        String  @db.VarChar(140)
  description String? @db.Text
  imageUrl    String? @db.VarChar(500)
  isActive    Boolean @default(true)

  store    Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  parentId Int?
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, slug])
  @@index([storeId, isActive])
  @@index([parentId])
}

model Product {
  id               Int           @id @default(autoincrement())
  storeId          Int
  categoryId       Int?
  name             String        @db.VarChar(200)
  slug             String        @db.VarChar(220)
  sku              String?       @db.VarChar(100)
  shortDescription String?       @db.VarChar(500)
  description      String?       @db.Text
  price            Decimal       @db.Decimal(12, 2)
  compareAtPrice   Decimal?      @db.Decimal(12, 2)
  status           ProductStatus @default(DRAFT)
  isAvailable      Boolean       @default(true)
  isFeatured       Boolean       @default(false)

  store      Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category   Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images     ProductImage[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, slug])
  @@unique([storeId, sku])
  @@index([storeId, status, isAvailable])
  @@index([storeId, categoryId])
  @@index([storeId, isFeatured])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  imageUrl  String  @db.VarChar(1000)
  altText   String? @db.VarChar(255)
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
}

model Customer {
  id           Int            @id @default(autoincrement())
  storeId      Int
  name         String         @db.VarChar(150)
  email        String?        @db.VarChar(191)
  phone        String?        @db.VarChar(40)
  passwordHash String?        @db.VarChar(255)
  status       CustomerStatus @default(ACTIVE)

  store  Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, email])
  @@index([storeId, phone])
  @@index([storeId, name])
}

model DeliveryZone {
  id          Int     @id @default(autoincrement())
  storeId     Int
  name        String  @db.VarChar(120)
  description String? @db.VarChar(500)
  charge      Decimal @db.Decimal(12, 2)
  isActive    Boolean @default(true)

  store  Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, name])
  @@index([storeId, isActive])
}

model Order {
  id             Int            @id @default(autoincrement())
  storeId        Int
  customerId     Int?
  deliveryZoneId Int?
  orderNumber    String         @db.VarChar(40)
  status         OrderStatus    @default(PENDING)
  paymentMethod  PaymentMethod
  paymentStatus  PaymentStatus  @default(PENDING)
  deliveryMethod DeliveryMethod @default(DELIVERY)

  customerName  String  @db.VarChar(150)
  customerEmail String? @db.VarChar(191)
  customerPhone String  @db.VarChar(40)

  shippingAddress  String? @db.Text
  shippingCity     String? @db.VarChar(120)
  shippingDistrict String? @db.VarChar(120)
  deliveryNotes    String? @db.Text

  subtotal       Decimal @db.Decimal(12, 2)
  deliveryCharge Decimal @default(0) @db.Decimal(12, 2)
  discount       Decimal @default(0) @db.Decimal(12, 2)
  total          Decimal @db.Decimal(12, 2)

  bankTransferReference String? @db.VarChar(150)
  adminNotes            String? @db.Text

  store        Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  deliveryZone DeliveryZone? @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  items        OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, orderNumber])
  @@index([storeId, status, createdAt])
  @@index([storeId, paymentStatus])
  @@index([customerId])
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int
  productId   Int?
  productName String  @db.VarChar(200)
  sku         String? @db.VarChar(100)
  imageUrl    String? @db.VarChar(1000)
  unitPrice   Decimal @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal @db.Decimal(12, 2)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model StoreUser {
  id           Int           @id @default(autoincrement())
  storeId      Int
  name         String        @db.VarChar(150)
  email        String        @db.VarChar(191)
  passwordHash String        @db.VarChar(255)
  role         StoreUserRole @default(ADMIN)
  isActive     Boolean       @default(true)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, email])
  @@index([storeId, isActive])
}
