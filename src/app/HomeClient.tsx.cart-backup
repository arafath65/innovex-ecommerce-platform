"use client";
import HomeHeaderHero from "./HomeHeaderHero";
import Image from "next/image";
import Link from "next/link";
import { Heart } from "lucide-react";
import { useWishlist } from "@/lib/useWishlist";
import AnimatedBenefitCards from "./AnimatedBenefitCards";
import CategoryMarquee from "./CategoryMarquee";
import FlashSaleCarousel from "./FlashSaleCarousel";
import { FaFacebookF, FaInstagram, FaTiktok, FaYoutube } from "react-icons/fa";

import {
  ArrowRight,
  ArrowUpRight,
  Clock3,
  Headphones,
  Mail,
  ShoppingBag,
} from "lucide-react";

type ProductImage = {

  id: number;

  imageUrl: string;

  altText: string | null;

  isPrimary: boolean;

  sortOrder: number;

};

type Product = {

  id: number;

  name: string;

  slug: string;

  price: string;

  compareAtPrice: string | null;

  shortDescription: string | null;

  isFeatured: boolean;

  isAvailable: boolean;

  createdAt: string;

  category: {

    id: number;

    name: string;

    slug: string;

  } | null;

  images: ProductImage[];

};

type Category = {

  id: number;

  name: string;

  slug: string;

  description: string | null;

  imageUrl: string | null;

  fallbackImageUrl: string | null;
  productCount: number;

};

type HeroSlide = {

  id: number;

  imageUrl: string;

  eyebrow: string | null;

  title: string | null;

  accentText: string | null;

  description: string | null;

  buttonText: string | null;

  buttonUrl: string | null;

  offerPercent: number | null;

};

type StoreInfo = {

  slug: string;
  facebookUrl: string | null;
instagramUrl: string | null;
tiktokUrl: string | null;
  youtubeUrl: string | null;

  name: string;

  displayName: string;

  tagline: string;

  description: string;

  aboutText: string | null;

  logoUrl: string | null;

  phone: string | null;

  whatsapp: string | null;

  email: string | null;

  currency: string;

  primaryColor: string;

  secondaryColor: string;

  accentColor: string;

  backgroundColor: string;

  surfaceColor: string;

  textColor: string;

  mutedColor: string;

  heroOfferPercent: number;

  announcementMessages?: string[];

};

type HomepageEditorial = {
  isEnabled: boolean;
  eyebrow: string;
  title: string;
  description: string;
  buttonText: string;
  buttonUrl: string;
  image1Url: string | null; image1Alt: string | null; image1Link: string | null;
  image2Url: string | null; image2Alt: string | null; image2Link: string | null;
  image3Url: string | null; image3Alt: string | null; image3Link: string | null;
  image4Url: string | null; image4Alt: string | null; image4Link: string | null;
};

type HomeClientProps = {

  store: StoreInfo;

  categories: Category[];

  products: Product[];

  flashSaleProducts: Product[];

  newArrivalProducts: Product[];

  heroSlides: HeroSlide[];


  homepageEditorial: HomepageEditorial | null;

  shopHref: string;
};

function imageUrl(value: string | null | undefined) {
  if (!value) return "";

  let url = value.trim().replace(/\\/g, "/");

  if (/^(https?:\/\/|data:|blob:)/i.test(url)) {
    return url;
  }

  url = url
    .replace(/^\.\//, "")
    .replace(/^\/?public\//i, "");

  const publicIndex = url.toLowerCase().lastIndexOf("/public/");
  if (publicIndex >= 0) {
    url = url.slice(publicIndex + 8);
  }

  return url.startsWith("/") ? url : `/${url}`;
}

function resolveStorefrontHref(
  value: string | null | undefined,
  shopHref: string,
  storeSlug: string,
) {
  const href = value?.trim() || "/shop";
  if (/^https?:\/\//i.test(href)) return href;
  if (!href.startsWith("/") || href.startsWith("//")) return shopHref;

  const previewPrefix = `/${storeSlug}`;
  const isSlugPreview = shopHref.startsWith(`${previewPrefix}/`);
  if (!isSlugPreview) return href;
  if (href === previewPrefix || href.startsWith(`${previewPrefix}/`)) return href;
  return `${previewPrefix}${href === "/" ? "" : href}`;
}

function productImage(product: Product) {

  const image =

    product.images.find((item) => item.isPrimary) ??

    product.images[0];

  return {

    src: imageUrl(image?.imageUrl),

    alt: image?.altText || product.name,

  };

}

function formatPrice(value: string | number, currency: string) {

  const amount = Number(value);

  if (!Number.isFinite(amount)) return `${currency} 0.00`;

  try {

    return new Intl.NumberFormat("en-LK", {

      style: "currency",

      currency,

      maximumFractionDigits: 2,

    }).format(amount);

  } catch {

    return `${currency} ${amount.toLocaleString("en-LK", {

      minimumFractionDigits: 2,

      maximumFractionDigits: 2,

    })}`;

  }

}

function discountPercent(product: Product) {

  const price = Number(product.price);

  const oldPrice = Number(product.compareAtPrice);

  if (

    !Number.isFinite(price) ||

    !Number.isFinite(oldPrice) ||

    oldPrice <= price

  ) {

    return 0;

  }

  return Math.round(((oldPrice - price) / oldPrice) * 100);

}

function categoryLink(slug: string) {

  return `/shop?category=${encodeURIComponent(slug)}`;

}

function StoreImage({
  src,
  alt,
  className,
}: {
  src: string;
  alt: string;
  className: string;
}) {
  if (!src) {
    return (
      <div
        className={`grid place-items-center ${className}`}
        aria-label="Product image unavailable"
      >
        <ShoppingBag className="h-8 w-8 text-black/20" />
      </div>
    );
  }

  return (
    <Image
      src={src}
      alt={alt}
      width={1200}
      height={1200}
      sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 25vw"
      unoptimized={/^(https?:\/\/|data:|blob:)/i.test(src)}
      className={className}
      loading="lazy"
    />
  );
}

function ProductCard({

  product,

  currency,

  primaryColor,

  surfaceColor,

  mutedColor,

  storeSlug,

}: {

  product: Product;

  currency: string;

  primaryColor: string;

  surfaceColor: string;

  mutedColor: string;

  storeSlug: string;

}) {

  const image = productImage(product);

  const discount = discountPercent(product);

  const { isWishlisted, toggleWishlist } = useWishlist(storeSlug);

  return (

    <article className="group min-w-0 overflow-hidden rounded-xl border border-black/[0.055] bg-white shadow-[0_1px_2px_rgba(0,0,0,0.025)] transition-shadow hover:shadow-sm">

      <Link

        href={`/product/${encodeURIComponent(product.slug)}`}

        className="block"

      >

        <div

          className="relative aspect-[1.42/1] overflow-hidden rounded-xl border border-black/[0.055] bg-white"

          style={{ backgroundColor: surfaceColor }}

        >

          <button
            type="button"
            aria-label={isWishlisted(product.id) ? "Remove from wishlist" : "Add to wishlist"}
            onClick={(event) => {
              event.preventDefault();
              event.stopPropagation();
              toggleWishlist(product.id);
            }}
            className="absolute right-3 top-3 z-10 grid size-9 place-items-center rounded-full bg-white/95 text-[#292B25] shadow-sm transition hover:scale-105 hover:text-[#d71920]"
          >
            <Heart
              size={18}
              fill={isWishlisted(product.id) ? "#d71920" : "none"}
              color={isWishlisted(product.id) ? "#d71920" : "currentColor"}
            />
          </button>
          <StoreImage

            src={image.src}

            alt={image.alt}

            className="h-full w-full object-contain p-1.5 transition duration-500 group-hover:scale-[1.045] sm:p-2"

          />

          <span
            className="absolute left-3 top-3 rounded-full px-3 py-1 text-[9px] font-bold uppercase tracking-[0.12em] text-white shadow-sm"
            style={{ backgroundColor: primaryColor }}
          >
            New
          </span>

          {discount > 0 && (
            <span className="absolute right-3 top-3 rounded-full bg-white/95 px-2.5 py-1 text-[9px] font-semibold text-[#292B25] shadow-sm">
              Save {discount}%
            </span>
          )}

          {!product.isAvailable && (

            <span className="absolute bottom-3 left-3 rounded-full bg-white/95 px-3 py-1.5 text-[10px] font-semibold text-black/60 shadow-sm">

              Currently unavailable

            </span>

          )}

          <span

            className="absolute bottom-3 right-3 grid size-10 translate-y-2 place-items-center rounded-full bg-white text-black opacity-0 shadow-md transition duration-300 group-hover:translate-y-0 group-hover:opacity-100"

            aria-hidden="true"

          >

            <ArrowUpRight size={17} />

          </span>

        </div>

      </Link>

      <div className="px-2.5 pb-3 pt-2">

        <p

          className="text-[10px] font-medium uppercase tracking-[0.14em]"

          style={{ color: mutedColor }}

        >

          {product.category?.name ?? "Kitchen essentials"}

        </p>

        <Link href={`/product/${encodeURIComponent(product.slug)}`}>

          <h3 className="mt-1.5 line-clamp-2 min-h-10 text-sm font-medium leading-5 text-[#292B25] transition group-hover:text-[#65734D]">

            {product.name}

          </h3>

        </Link>

        <div className="mt-2 flex flex-wrap items-baseline gap-2">

          <span className="text-sm font-semibold text-[#292B25]">

            {formatPrice(product.price, currency)}

          </span>

          {discount > 0 && product.compareAtPrice && (

            <span className="text-xs text-black/35 line-through">

              {formatPrice(product.compareAtPrice, currency)}

            </span>

          )}

        </div>

      </div>

    </article>

  );

}

export default function HomeClient({
  store,
  categories,
  products,
  flashSaleProducts,
  newArrivalProducts,
  heroSlides,
  homepageEditorial,
  shopHref,
}: HomeClientProps) {

  const primaryColor = store.primaryColor;
const surfaceColor = store.surfaceColor;
const mutedColor = store.mutedColor;

  const fallbackHeroImage = products[0]

  ? productImage(products[0]).src

  : "";

  const dealProducts = products.filter(

    (product) => discountPercent(product) > 0,

  );

  // Interleave products by category so the homepage shows a varied collection
  // rather than a full row dominated by one category when possible.
  const categoryQueues = new Map<string, Product[]>();
  for (const product of newArrivalProducts) {
    const categoryKey = product.category?.slug ?? "uncategorized";
    const queue = categoryQueues.get(categoryKey) ?? [];
    queue.push(product);
    categoryQueues.set(categoryKey, queue);
  }

  const mixedProducts: Product[] = [];
  while (mixedProducts.length < 15 && categoryQueues.size > 0) {
    for (const [categoryKey, queue] of categoryQueues) {
      const nextProduct = queue.shift();
      if (nextProduct) mixedProducts.push(nextProduct);
      if (queue.length === 0) categoryQueues.delete(categoryKey);
      if (mixedProducts.length >= 15) break;
    }
  }

  const whatsappHref = store.whatsapp

    ? `https://wa.me/${store.whatsapp.replace(/\D/g, "")}`

    : null;

  return (

    <main

      className="min-h-screen"

      style={{

        backgroundColor: store.backgroundColor,

        color: store.textColor,

      }}

    >

      <HomeHeaderHero
        store={store}
        categories={categories}
        heroSlides={heroSlides}
        fallbackImage={fallbackHeroImage}
        hasSpecialOffers={dealProducts.length > 0}
      />

      {/* Benefits */}

      <AnimatedBenefitCards />

      {/* Categories */}
<CategoryMarquee
  categories={categories
    .filter((category) => Boolean(imageUrl(category.imageUrl)))
    .map((category) => ({
      id: category.id,
      name: category.name,
      slug: category.slug,
      imageUrl: imageUrl(category.imageUrl),
      productCount: category.productCount,
    }))}
  primaryColor={primaryColor}
/>

{/* Flash Sale */}
{flashSaleProducts.length > 0 && (
  <FlashSaleCarousel
    products={flashSaleProducts}
    currency={store.currency}
    primaryColor={primaryColor}
    surfaceColor={surfaceColor}
    mutedColor={mutedColor}
  />
)}

      {/* Store-configurable editorial hero with four animated image panels */}
      {homepageEditorial?.isEnabled &&
        [
          homepageEditorial.image1Url,
          homepageEditorial.image2Url,
          homepageEditorial.image3Url,
          homepageEditorial.image4Url,
        ].every(Boolean) && (
          <section className="editorial-hero-wrap px-4 py-10 sm:px-7 sm:py-14 lg:px-12">
            <div className="editorial-hero mx-auto max-w-[1440px]">
              <div className="editorial-hero-copy">
                {homepageEditorial.eyebrow.trim() ? (
                  <p className="editorial-hero-eyebrow" style={{ color: primaryColor }}>
                    <span aria-hidden="true" />
                    {homepageEditorial.eyebrow}
                    <span aria-hidden="true" />
                  </p>
                ) : null}
                {homepageEditorial.title.trim() ? (
                  <h2 className="editorial-hero-title">
                    {homepageEditorial.title}
                  </h2>
                ) : null}
                {homepageEditorial.description.trim() ? (
                  <p className="editorial-hero-description">
                    {homepageEditorial.description}
                  </p>
                ) : null}
                {homepageEditorial.buttonText.trim() ? (
                  <Link
                    href={resolveStorefrontHref(homepageEditorial.buttonUrl, shopHref, store.slug)}
                    className="editorial-hero-button"
                    style={{ backgroundColor: primaryColor }}
                  >
                    {homepageEditorial.buttonText}
                    <ArrowRight size={16} />
                  </Link>
                ) : null}
              </div>

              <div className="editorial-hero-gallery">
                {[
                  { url: homepageEditorial.image1Url, alt: homepageEditorial.image1Alt, link: homepageEditorial.image1Link },
                  { url: homepageEditorial.image2Url, alt: homepageEditorial.image2Alt, link: homepageEditorial.image2Link },
                  { url: homepageEditorial.image3Url, alt: homepageEditorial.image3Alt, link: homepageEditorial.image3Link },
                  { url: homepageEditorial.image4Url, alt: homepageEditorial.image4Alt, link: homepageEditorial.image4Link },
                ].map((item, index) => {
                  const image = (
                    <div className={`editorial-hero-image editorial-hero-image-${index + 1}`}>
                      <StoreImage
                        src={imageUrl(item.url)}
                        alt={item.alt?.trim() || `${store.displayName} collection image ${index + 1}`}
                        className="h-full w-full object-cover"
                      />
                    </div>
                  );

                  return item.link?.trim() ? (
                    <Link
                      key={index}
                      href={resolveStorefrontHref(item.link, shopHref, store.slug)}
                      className={`editorial-hero-image-link editorial-hero-image-link-${index + 1}`}
                    >
                      {image}
                    </Link>
                  ) : (
                    <div key={index} className={`editorial-hero-image-link editorial-hero-image-link-${index + 1}`}>
                      {image}
                    </div>
                  );
                })}
              </div>
            </div>
          </section>
        )}


      {/* Mixed product collection: 3 rows with up to 5 products per row */}
      <section className="bg-white py-12 sm:py-16">
        <div className="mx-auto max-w-[1440px] px-4 sm:px-7 lg:px-12">
          <div className="mb-8 flex flex-col items-center justify-between gap-4 text-center sm:mb-10">
            <div className="flex flex-col items-center">
              <p
                className="text-[10px] font-semibold uppercase tracking-[0.2em]"
                style={{ color: primaryColor }}
              >
                A little of everything
              </p>
              <h2 className="mt-2 text-2xl font-medium tracking-[-0.04em] text-[#292B25] sm:text-3xl">
                Explore Our Collection
              </h2>
              <p className="mt-2 max-w-lg text-xs leading-5 text-[#77776D] sm:text-sm">
                Discover a thoughtful mix of products for your kitchen and home.
              </p>
            </div>

            <Link
              href={shopHref}
              className="inline-flex shrink-0 items-center gap-2 text-xs font-medium"
              style={{ color: primaryColor }}
            >
              View all
              <ArrowRight size={15} />
            </Link>
          </div>

          {newArrivalProducts.length > 0 ? (
            <div className="grid grid-cols-2 gap-x-3 gap-y-7 sm:grid-cols-3 sm:gap-x-5 sm:gap-y-9 lg:grid-cols-5 lg:gap-x-6">
              {mixedProducts.slice(0, 15).map((product) => (
                <ProductCard
                  key={product.id}
                  product={product}
                  currency={store.currency}
                  primaryColor={primaryColor}
                  surfaceColor={surfaceColor}
                  mutedColor={mutedColor}
                  storeSlug={store.slug}
                />
              ))}
            </div>
          ) : (
            <div
              className="rounded-3xl px-5 py-14 text-center"
              style={{ backgroundColor: surfaceColor }}
            >
              <ShoppingBag
                size={30}
                strokeWidth={1.2}
                className="mx-auto text-black/30"
              />
              <h3 className="mt-4 text-lg font-medium text-[#292B25]">
                New discoveries are on the way
              </h3>
              <p className="mx-auto mt-2 max-w-md text-sm leading-6 text-[#77776D]">
                Check back soon to see the latest additions to our collection.
              </p>
            </div>
          )}
        </div>
      </section>

      {/* Footer */}

      <footer className="mt-16 border-t border-white/[0.08] bg-[#0b0b0b] text-white">
  <div className="mx-auto grid max-w-[1440px] gap-12 px-5 py-14 sm:grid-cols-2 sm:px-8 lg:grid-cols-[1.35fr_1fr_1fr_1.2fr] lg:gap-16 lg:px-12 lg:py-20">
    <div>
      <Link href="/" className="inline-flex items-center gap-3">
        {store.logoUrl ? (
          <StoreImage
            src={imageUrl(store.logoUrl)}
            alt={`${store.displayName} logo`}
            className="h-12 w-12 shrink-0 rounded-full border border-white/10 bg-white object-contain p-1"
          />
        ) : (
          <span
            className="grid size-12 place-items-center rounded-full text-base font-semibold text-white"
            style={{ backgroundColor: primaryColor }}
          >
            {store.displayName.charAt(0).toUpperCase()}
          </span>
        )}
        <span className="text-sm font-bold tracking-[0.14em]">
          {store.displayName.toUpperCase()}
        </span>
      </Link>

      <p className="mt-5 max-w-xs text-sm leading-7 text-white/50">
        {store.tagline}
      </p>

      <div className="mt-6 flex items-center gap-3">
        {[
          { label: "Facebook", url: store.facebookUrl, Icon: FaFacebookF },
          { label: "Instagram", url: store.instagramUrl, Icon: FaInstagram },
          { label: "TikTok", url: store.tiktokUrl, Icon: FaTiktok },
          { label: "YouTube", url: store.youtubeUrl, Icon: FaYoutube },
        ].filter((social) => social.url?.trim()).map(({ label, url, Icon }) => (
          <a
            key={label}
            href={url!}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={label}
            title={label}
            className="grid size-10 place-items-center rounded-full border border-white/10 bg-white/[0.04] text-white/65 transition-all hover:-translate-y-1 hover:border-white/30 hover:bg-white/10 hover:text-white"
          >
            <Icon size={15} />
          </a>
        ))}
      </div>

      <div className="mt-6 h-px w-12 bg-[#ff4148]" />
    </div>

    <div>
      <h3 className="text-[11px] font-bold uppercase tracking-[0.2em] text-white">
        Explore
      </h3>
      <div className="mt-5 space-y-3.5 text-sm text-white/55">
        <Link href="/shop" className="block transition-colors hover:translate-x-1 hover:text-white">
          Shop all products
        </Link>
        <Link href="/wishlist" className="block transition-colors hover:translate-x-1 hover:text-white">
          Wishlist
        </Link>
        <Link href="/cart" className="block transition-colors hover:translate-x-1 hover:text-white">
          Shopping cart
        </Link>
        <Link href="/account" className="block transition-colors hover:translate-x-1 hover:text-white">
          My account
        </Link>
      </div>
    </div>

    <div>
      <h3 className="text-[11px] font-bold uppercase tracking-[0.2em] text-white">
        Customer care
      </h3>
      <div className="mt-5 space-y-3.5 text-sm text-white/55">
        <Link href="/track-order" className="block transition-colors hover:translate-x-1 hover:text-white">
          Track your order
        </Link>
        <Link href="/shipping" className="block transition-colors hover:translate-x-1 hover:text-white">
          Shipping information
        </Link>
        <Link href="/returns" className="block transition-colors hover:translate-x-1 hover:text-white">
          Returns &amp; refunds
        </Link>
        <Link href="/faq" className="block transition-colors hover:translate-x-1 hover:text-white">
          Frequently asked questions
        </Link>
      </div>
    </div>

    <div>
      <h3 className="text-[11px] font-bold uppercase tracking-[0.2em] text-white">
        Contact us
      </h3>

      <div className="mt-5 space-y-4 text-sm text-white/55">
        {store.phone && (
          <p className="flex items-center gap-3">
            <span className="grid size-8 shrink-0 place-items-center rounded-full border border-white/10 bg-white/[0.04]">
              <Headphones size={14} />
            </span>
            {store.phone}
          </p>
        )}

        {store.email && (
          <a
            href={`mailto:${store.email}`}
            className="flex items-center gap-3 transition-colors hover:text-white"
          >
            <span className="grid size-8 shrink-0 place-items-center rounded-full border border-white/10 bg-white/[0.04]">
              <Mail size={14} />
            </span>
            <span className="break-all">{store.email}</span>
          </a>
        )}

        {whatsappHref && (
          <a
            href={whatsappHref}
            target="_blank"
            rel="noreferrer"
            className="flex items-center gap-3 transition-colors hover:text-white"
          >
            <span className="grid size-8 shrink-0 place-items-center rounded-full border border-white/10 bg-white/[0.04]">
              <Headphones size={14} />
            </span>
            Chat on WhatsApp
          </a>
        )}

        <p className="flex items-center gap-3">
          <span className="grid size-8 shrink-0 place-items-center rounded-full border border-white/10 bg-white/[0.04]">
            <Clock3 size={14} />
          </span>
          Online shopping, anytime
        </p>
      </div>

      {categories.length > 0 && (
        <div className="mt-6 flex flex-wrap gap-2">
          {categories.slice(0, 5).map((category) => (
            <Link
              key={category.id}
              href={categoryLink(category.slug)}
              className="rounded-full border border-white/10 px-3 py-1.5 text-[11px] text-white/45 transition-colors hover:border-white/30 hover:text-white"
            >
              {category.name}
            </Link>
          ))}
        </div>
      )}
    </div>
  </div>

  <div className="border-t border-white/[0.08]">
    <div className="mx-auto flex max-w-[1440px] flex-col gap-3 px-5 py-5 text-[11px] text-white/35 sm:flex-row sm:items-center sm:justify-between sm:px-8 lg:px-12">
      <p>
        © {new Date().getFullYear()} {store.displayName}. All rights reserved.
      </p>
      <p className="flex items-center gap-2">
        Prices displayed in {store.currency}
        <span className="text-white/15">|</span>
        Secure shopping
      </p>
    </div>
  </div>
</footer>

    </main>

  );

}







