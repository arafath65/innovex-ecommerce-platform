# Copy this file to .env.local for local development.
# Never commit .env.local or production secrets.

# MySQL connection used by Prisma 7 adapter
DATABASE_URL="mysql://innovex_app:CHANGE_ME@127.0.0.1:3306/innovex_ecommerce"

# Platform domains are not tenant stores.
APP_BASE_DOMAINS="innovexweb.test,www.innovexweb.test,admin.innovexweb.test"

# Used only as a local fallback for http://localhost:3000.
# Production ignores this and requires an active store_domain record.
STOREFRONT_STORE_SLUG="oscar-trading"
# Optional production-only switch for internal slug preview routes.
# Keep false (or unset) when tenant access should require a mapped hostname.
ALLOW_SLUG_STOREFRONT_PREVIEW="false"

# Separate media directory. Must be outside the Next.js project folder.
# Example for Windows:
MEDIA_STORAGE_ROOT="D:/InnovexData/media"
# Example for Linux VPS:
# MEDIA_STORAGE_ROOT="/var/lib/innovex-ecommerce/media"

# Optional local hostname-to-store mapping overrides.
LOCAL_OSCAR_STORE_SLUG="oscar-trading"
LOCAL_SECOND_STORE_SLUG="second-store"

# Do not set NODE_ENV manually for normal `next dev` / `next start` commands.
